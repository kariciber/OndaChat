rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isGoogleUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function isModerator() {
      return isGoogleUser()
        && exists(/databases/$(database)/documents/moderators/$(request.auth.uid))
        && get(/databases/$(database)/documents/moderators/$(request.auth.uid)).data.active == true;
    }
    function musicRoom(roomId) {
      return roomId in ['general', 'pop', 'rock', 'electronica', 'chill'];
    }
    function techRoom(roomId) {
      return roomId == 'informatica' && isGoogleUser();
    }

    // El rol solo lo crea una persona propietaria desde Firebase Console/Admin SDK.
    // Nunca se puede conceder a sí mismo desde el navegador.
    match /moderators/{moderatorUid} {
      allow get: if isGoogleUser() && request.auth.uid == moderatorUid;
      allow list, create, update, delete: if false;
    }

    // Las cinco salas musicales actuales siguen accesibles con sesión anónima.
    // La sala de informática requiere iniciar sesión con Google.
    match /rooms/{roomId}/messages/{messageId} {
      allow read: if request.auth != null && (musicRoom(roomId) || techRoom(roomId));
      allow create: if request.auth != null
        && (musicRoom(roomId) || techRoom(roomId))
        && request.resource.data.keys().hasOnly(['uid', 'nickname', 'text', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'nickname', 'text', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 24
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isModerator();
    }

    // Centro de preguntas y respuestas técnicas en pruebas.
    match /techQuestions/{questionId} {
      allow read: if isGoogleUser();
      allow create: if isGoogleUser()
        && request.resource.data.keys().hasOnly(['uid','nickname','category','title','details','status','createdAt'])
        && request.resource.data.keys().hasAll(['uid','nickname','category','title','details','status','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 24
        && request.resource.data.category in ['windows','linux','redes','hardware','seguridad','programacion','otros']
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 8
        && request.resource.data.title.size() <= 120
        && request.resource.data.details is string
        && request.resource.data.details.size() >= 20
        && request.resource.data.details.size() <= 1200
        && request.resource.data.status == 'abierta'
        && request.resource.data.createdAt == request.time;

      // Solo quien hizo la pregunta puede elegir una respuesta como solución.
      // Se conservan los campos originales, permitiendo cambiar únicamente
      // el estado y la referencia a una respuesta realmente existente.
      allow update: if isGoogleUser()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status','solutionAnswerId'])
        && request.resource.data.keys().hasOnly(
             ['uid','nickname','category','title','details','status','createdAt','solutionAnswerId'])
        && request.resource.data.status == 'resuelta'
        && request.resource.data.solutionAnswerId is string
        && request.resource.data.solutionAnswerId.size() > 0
        && request.resource.data.solutionAnswerId.size() <= 80
        && exists(/databases/$(database)/documents/techQuestions/$(questionId)/answers/$(request.resource.data.solutionAnswerId));
      allow delete: if isModerator();

      match /answers/{answerId} {
        allow read: if isGoogleUser();
        allow create: if isGoogleUser()
          && exists(/databases/$(database)/documents/techQuestions/$(questionId))
          && request.resource.data.keys().hasOnly(['uid','nickname','text','createdAt'])
          && request.resource.data.keys().hasAll(['uid','nickname','text','createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() > 0
          && request.resource.data.nickname.size() <= 24
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 10
          && request.resource.data.text.size() <= 800
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isModerator();
      }
    }

    // Avisos de contenido para revisión manual por la administración.
    // Cualquier persona con Google puede denunciar; solo moderación puede leer.
    match /techReports/{reportId} {
      allow create: if isGoogleUser()
        && request.resource.data.keys().hasOnly(['uid','resourceType','resourceId','parentId','reason','createdAt'])
        && request.resource.data.keys().hasAll(['uid','resourceType','resourceId','parentId','reason','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.resourceType in ['question','answer','chat']
        && request.resource.data.resourceId is string
        && request.resource.data.resourceId.size() > 0
        && request.resource.data.resourceId.size() <= 80
        && request.resource.data.parentId is string
        && request.resource.data.parentId.size() <= 80
        && (
          (request.resource.data.resourceType == 'question' && request.resource.data.parentId == '')
          || (request.resource.data.resourceType == 'answer' && request.resource.data.parentId.size() > 0)
          || (request.resource.data.resourceType == 'chat'
              && (musicRoom(request.resource.data.parentId) || request.resource.data.parentId == 'informatica'))
        )
        && reportId == request.auth.uid + '_' + request.resource.data.resourceType + '_' + request.resource.data.resourceId
        && request.resource.data.reason == 'contenido_inapropiado'
        && request.resource.data.createdAt == request.time;
      allow read: if isModerator();
      allow update: if isModerator()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt'])
        && request.resource.data.keys().hasOnly(['uid','resourceType','resourceId','parentId','reason','createdAt','status','reviewedBy','reviewedAt'])
        && request.resource.data.status == 'revisada'
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}