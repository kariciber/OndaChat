rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId}/messages/{messageId} {
      allow read: if request.auth != null && roomId in ['general', 'pop', 'rock', 'electronica', 'chill'];
      allow create: if request.auth != null
        && roomId in ['general', 'pop', 'rock', 'electronica', 'chill']
        && request.resource.data.keys().hasOnly(['uid', 'nickname', 'text', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'nickname', 'text', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 24
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}